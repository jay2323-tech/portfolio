# Environment variables (set in Vercel dashboard for production)

# Phase 3 — RAG
# Generation (prefer Anthropic; OpenAI also works)
ANTHROPIC_API_KEY=
# Embeddings at build time + query embed (OpenAI). Optional — local hash embedder used if unset.
OPENAI_API_KEY=

# Contact (M-7) — without RESEND_API_KEY, submissions are logged server-side only
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@jayanthkrishna.dev

# Public
NEXT_PUBLIC_SITE_URL=http://localhost:2005
